# ATOA Protocol Environment Configuration Example
# Copy this file to .env and adjust values for your environment.

# --- Backend & Server Configuration ---
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=development
LOG_LEVEL=INFO

# --- Web3 & Smart Contract Settlement Layer ---
# RPC URL for Ethereum node, L2, or local Anvil/Hardhat testnet
WEB3_RPC_URL=http://127.0.0.1:8545
RPC_URL=http://127.0.0.1:8545

# Deployed AtoaSettlementEscrow contract address
ESCROW_CONTRACT_ADDRESS=0x5FbDB2315678afecb367f032d93F642f64180aa3
ATOA_ESCROW_ADDRESS=0x5FbDB2315678afecb367f032d93F642f64180aa3

# Protocol Oracle private key for automated transaction signing (Anvil Account 0 default for dev)
PROTOCOL_PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80
ORACLE_PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80

# Settlement Token Settings
USDC_DECIMALS=6
TOKEN_DECIMALS=6

# Set to true to enable simulated in-memory Web3 settlement for testing without a live node
MOCK_WEB3=false
ALLOW_FALLBACK_ON_ERROR=false

# --- Frontend Dashboard Telemetry ---
VITE_API_URL=http://localhost:8000
VITE_WS_URL=ws://localhost:8000/v1/events/ws
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000/v1/events/ws
